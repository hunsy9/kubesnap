Output ../main.gif

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 450

Sleep 1s
Type "kubesnap" 
Sleep 500ms
Enter
Sleep 3s

Ctrl+L
Sleep 1s

Type "kubesnap ctx"
Sleep 500ms
Enter
Sleep 1s

Down
Sleep 500ms
Down
Sleep 1s
Type "/"
Sleep 500ms
Type "general"
Enter
Sleep 3s

Ctrl+L
Sleep 1s

Type "kubesnap ns"
Sleep 500ms
Enter
Sleep 2s
Down
Sleep 300ms
Down
Sleep 300ms
Enter

Sleep 4s
